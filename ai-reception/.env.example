# ─── Telephony (Twilio is the cheapest easy start; swap later) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Number to transfer urgent calls to (your technician line)
TRANSFER_TARGET_NUMBER=

# Public URL where this server is reachable (e.g. from ngrok or your VPS domain)
PUBLIC_BASE_URL=https://your-server.example.com

# ─── LLM ───
# Option A (free, self-hosted): point at a local Ollama server
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Option B (paid, better quality): uncomment and set
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ─── Speech-to-text (Whisper, self-hosted/free) ───
WHISPER_MODEL=base.en

# ─── Text-to-speech (Kokoro, self-hosted/free) ───
TTS_VOICE=af_heart

# ─── CRM push (your ticketing system) ───
CRM_WEBHOOK_URL=https://fiji.dickens.org/api/leads
CRM_WEBHOOK_TOKEN=
